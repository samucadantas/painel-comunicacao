# Painel de Comunicação · Somos A Ponte
NOTION_TOKEN=ntn_seu_token_aqui

# Banco de Dados de Comunicação
DB_ID=cole_aqui_o_id_da_base_de_comunicacao
# Acompanhamento de Pedidos
DB_SOLICITANTES=cole_aqui_o_id_da_base_de_solicitantes
# Ranking Ministérios
DB_MINISTERIOS=cole_aqui_o_id_da_base_de_ministerios

# YouTube Data API v3 (opcional — sem isso a seção do YouTube fica vazia)
YT_API_KEY=
YT_HANDLE=somosaponte

# Meta Graph API — métricas de Instagram (alcance, salvamentos, compartilhamentos,
# desempenho por publicação). Chave de "usuário de sistema", com validade "Nunca":
# token comum de usuário expira em 60 dias e quebraria o painel sem avisar.
META_TOKEN=cole_aqui_a_chave_do_usuario_de_sistema

# Genna — reserva, enquanto a chave da Meta não estiver no ar (serviço pago, por crédito)
GENNA_API_KEY=
GENNA_BRAND_ID=143782
